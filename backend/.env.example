# Ejemplo para el backend con PostgreSQL en AWS RDS.
# Spring Boot no carga este archivo automaticamente: exportar las variables
# en el entorno del proceso o configurarlas en la ejecucion del IDE.
SERVER_PORT=8080

# Usuario y nombre de base mostrados en el fragmento de conexion de RDS.
# Confirmar el nombre real de la base desde pgAdmin antes de conectar.
DB_USERNAME=AdminAWS
DB_PASSWORD=Adminaws123!
# Descargar el certificado de RDS y sustituir su ruta en el entorno real.
# sslmode=verify-full verifica el certificado y el nombre del servidor.
DB_URL=jdbc:postgresql://erp-database.coxoq4mwa6sg.us-east-1.rds.amazonaws.com:5432/erp_database?sslmode=verify-full&sslrootcert=E:/SI2/certificados/global-bundle.pem

CORS_ORIGIN=https://erp-contable-comercial.online

# Clave publica de ejemplo, solo para desarrollo. Sustituir en produccion
# por una clave aleatoria privada de al menos 32 bytes UTF-8.
JWT_SECRET=dev_only_change_in_production_9f7b1c3e
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

# Cuenta de prueba: el seeder solo la crea si no existe.
SEED_ADMIN_EMAIL=admin@erp.com
SEED_ADMIN_PASSWORD=Admin123!

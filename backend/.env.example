# Ejemplo para el backend con PostgreSQL en AWS RDS.
# Spring Boot no carga este archivo automaticamente: exportar las variables
# en el entorno del proceso o configurarlas en la ejecucion del IDE.
SERVER_PORT=8080

DB_USERNAME=erp_asus_app
DB_PASSWORD=REEMPLAZAR_DESDE_SECRETS_MANAGER
DB_URL=jdbc:postgresql://RDS_ENDPOINT:5432/ERP_Asus?sslmode=require

# Base central SaaS y credenciales de aplicacion con privilegios limitados.
MASTER_DB_URL=jdbc:postgresql://RDS_ENDPOINT:5432/ERP_Master?sslmode=require
MASTER_DB_USERNAME=erp_master_app
MASTER_DB_PASSWORD=REEMPLAZAR_DESDE_SECRETS_MANAGER
TENANT_DB_USERNAME=erp_asus_app
TENANT_DB_PASSWORD=REEMPLAZAR_DESDE_SECRETS_MANAGER
MASTER_DB_MAX_POOL_SIZE=5
TENANT_DB_MAX_POOL_SIZE=5

# Credencial de aprovisionamiento: solo el backend; requiere CREATEDB.
PROVISIONING_DB_URL=jdbc:postgresql://RDS_ENDPOINT:5432/postgres?sslmode=require
PROVISIONING_DB_BASE_URL=jdbc:postgresql://RDS_ENDPOINT:5432
PROVISIONING_DB_USERNAME=erp_tenant_provisioner
PROVISIONING_DB_PASSWORD=REEMPLAZAR_DESDE_SECRETS_MANAGER
TENANT_RUNTIME_SECRET_ARN=
RDS_INSTANCE_IDENTIFIER=erp-prod-postgresql
RDS_HOST=RDS_ENDPOINT
TENANT_SCHEMA_VERSION=1.0.0
DEMO_INITIALIZERS_ENABLED=false

CORS_ORIGIN=https://erp-contable-comercial.online

# Clave publica de ejemplo, solo para desarrollo. Sustituir en produccion
# por una clave aleatoria privada de al menos 32 bytes UTF-8.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

# Cuenta de prueba: el seeder solo la crea si no existe.
SEED_ADMIN_EMAIL=admin@erp.com
SEED_ADMIN_PASSWORD=Admin123!

# Catalogo global de paises y monedas
REST_COUNTRIES_API_TOKEN=
CATALOGOS_PAISES_URL=https://api.restcountries.com/countries/v5
CATALOGOS_CACHE_MINUTES=360
CATALOGOS_CONNECT_TIMEOUT_MS=3000
CATALOGOS_READ_TIMEOUT_MS=5000

# CU39 - Webhook del flujo N8N que interpreta los comandos de voz.
# Vacio = el backend usa su interprete local.
N8N_REPORTES_VOZ_URL=
N8N_REPORTES_VOZ_TOKEN=
N8N_REPORTES_VOZ_TIMEOUT_MS=8000

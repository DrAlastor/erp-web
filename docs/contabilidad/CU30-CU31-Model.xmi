			</packagedElement>

			<!-- ============================================== -->
			<!-- DIAGRAMAS DE SECUENCIA (INTERACCIONES UML)     -->
			<!-- ============================================== -->

			<!-- 1. SECUENCIA LIBRO DIARIO -->
			<packagedElement xmi:type="uml:Interaction" xmi:id="EAID_INT_DIARIO" name="CU30 - Consultar Libro Diario">
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_D_CONTADOR" name="c: Contador" represents="EAID_ACTOR_CONTADOR"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_D_CTRL" name="ctrl: LibrosContablesController" represents="EAID_CLS_LIBROS_CTRL"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_D_SRV" name="srv: LibrosContablesService" represents="EAID_CLS_LIBROS_SRV"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_D_REPO" name="repoAsiento: AsientoContableRepository" represents="EAID_CLS_REPO_ASIENTO"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_D_RESP" name="response: LibroDiarioResponse" represents="EAID_DTO_DIARIO"/>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_LOOP_ASIENTOS" name="Loop Asientos" interactionOperator="loop">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_LOOP_A">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_LOOP_A">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_LOOP_A" value="Para cada asiento in listaAsientos"/>
						</guard>
					</operand>
				</fragment>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_ALT_CUADRE" name="Alt Cuadre Partida Doble" interactionOperator="alt">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_CUADRADO">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_C1">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_C1" value="Total Debe == Total Haber"/>
						</guard>
					</operand>
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_DESCUADRADO">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_C2">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_C2" value="Total Debe != Total Haber"/>
						</guard>
					</operand>
				</fragment>
			</packagedElement>

			<!-- 2. SECUENCIA LIBRO MAYOR -->
			<packagedElement xmi:type="uml:Interaction" xmi:id="EAID_INT_MAYOR" name="CU30 - Consultar Libro Mayor">
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_CONTADOR" name="c: Contador" represents="EAID_ACTOR_CONTADOR"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_CTRL" name="ctrl: LibrosContablesController" represents="EAID_CLS_LIBROS_CTRL"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_SRV" name="srv: LibrosContablesService" represents="EAID_CLS_LIBROS_SRV"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_REPO_CTA" name="repoCuenta: CuentaContableRepository" represents="EAID_CLS_REPO_CUENTA"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_REPO_DET" name="repoDetalle: AsientoDetalleRepository" represents="EAID_CLS_REPO_DETALLE"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_M_RESP" name="mayorResp: LibroMayorResponse" represents="EAID_DTO_MAYOR"/>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_ALT_CUENTA" name="Alt Cuenta Valida" interactionOperator="alt">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_C_INVALIDA">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_CI">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_CI" value="!cuenta.getPermiteMovimiento()"/>
						</guard>
					</operand>
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_C_VALIDA">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_CV">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_CV" value="cuenta.getPermiteMovimiento()"/>
						</guard>
					</operand>
				</fragment>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_LOOP_MOVS" name="Loop Movimientos Mayor" interactionOperator="loop">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_LMOVS">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_LM">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_LM" value="Para cada detalle in listaMovimientos"/>
						</guard>
					</operand>
				</fragment>
			</packagedElement>

			<!-- 3. SECUENCIA BALANCE GENERAL -->
			<packagedElement xmi:type="uml:Interaction" xmi:id="EAID_INT_BALANCE" name="CU31 - Consultar Balance General">
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_GERENTE" name="g: Gerente General" represents="EAID_ACTOR_GERENTE"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_CTRL" name="ctrl: InformacionFinancieraController" represents="EAID_CLS_FINANZAS_CTRL"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_SRV" name="srv: InformacionFinancieraService" represents="EAID_CLS_FINANZAS_SRV"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_REPO_CTA" name="repoCuenta: CuentaContableRepository" represents="EAID_CLS_REPO_CUENTA"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_REPO_DET" name="repoDetalle: AsientoDetalleRepository" represents="EAID_CLS_REPO_DETALLE"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_CALC" name="calc: CalculadoraFinanciera" represents="EAID_CLS_CALCULADORA"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_B_RESP" name="balance: BalanceGeneralResponse" represents="EAID_DTO_BALANCE"/>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_LOOP_SALDOS" name="Loop Saldos Cuentas" interactionOperator="loop">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_LSALDOS">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_LS">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_LS" value="Para cada cuenta in todasLasCuentas"/>
						</guard>
					</operand>
				</fragment>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_ALT_ECUACION" name="Alt Ecuacion Patrimonial" interactionOperator="alt">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_ECU_OK">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_EOK">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_EOK" value="diferencia == 0.00 (Balance Cuadrado)"/>
						</guard>
					</operand>
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_ECU_ERR">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_EERR">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_EERR" value="diferencia != 0.00 (Descuadre)"/>
						</guard>
					</operand>
				</fragment>
			</packagedElement>

			<!-- 4. SECUENCIA ESTADO RESULTADOS -->
			<packagedElement xmi:type="uml:Interaction" xmi:id="EAID_INT_ESTADO" name="CU31 - Consultar Estado de Resultados">
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_GERENTE" name="g: Gerente General" represents="EAID_ACTOR_GERENTE"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_CTRL" name="ctrl: InformacionFinancieraController" represents="EAID_CLS_FINANZAS_CTRL"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_SRV" name="srv: InformacionFinancieraService" represents="EAID_CLS_FINANZAS_SRV"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_REPO_CTA" name="repoCuenta: CuentaContableRepository" represents="EAID_CLS_REPO_CUENTA"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_CALC" name="calc: CalculadoraFinanciera" represents="EAID_CLS_CALCULADORA"/>
				<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL_R_RESP" name="estadoResp: EstadoResultadosResponse" represents="EAID_DTO_ESTADO_RES"/>

				<fragment xmi:type="uml:CombinedFragment" xmi:id="EAID_LOOP_ANALISIS" name="Loop Analisis Vertical" interactionOperator="loop">
					<operand xmi:type="uml:InteractionOperand" xmi:id="OPND_LANALISIS">
						<guard xmi:type="uml:InteractionConstraint" xmi:id="GRD_LA">
							<specification xmi:type="uml:LiteralString" xmi:id="SP_LA" value="Para cada cuenta de costo y gasto"/>
						</guard>
					</operand>
				</fragment>
			</packagedElement>

		</packagedElement>
	</uml:Model>

	<!-- ========================================================================= -->
	<!-- EXTENSION ENTERPRISE ARCHITECT: DIAGRAMAS VISUALES CLICKEABLES            -->
	<!-- ========================================================================= -->
	<xmi:Extension extender="Enterprise Architect" extenderID="6.5">

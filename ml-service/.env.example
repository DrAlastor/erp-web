# Servicio de ML de NexoERP (Inteligencia de Negocio).
# Copiar a .env y completar. Nunca subir el .env real al repositorio.

# Clave compartida con el backend Spring (ML_CLAVE_INTERNA en backend/.env).
# Sin clave, el servicio rechaza todos los pedidos protegidos (falla cerrado).
ML_CLAVE_INTERNA=REEMPLAZAR_CON_CLAVE_ALEATORIA_LARGA

# Base central SaaS: se usa solo para resolver la base de datos de cada empresa.
ML_MASTER_DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@RDS_ENDPOINT:5432/ERP_Master?sslmode=require

# Credenciales para conectarse a la base de cada empresa (las mismas que TENANT_DB_* del backend).
ML_TENANT_DB_USUARIO=erp_tenant_app
ML_TENANT_DB_CLAVE=REEMPLAZAR
ML_TENANT_DB_HOST_POR_DEFECTO=RDS_ENDPOINT
ML_TENANT_DB_SSLMODE=require

# Zona horaria del negocio: define "hoy" para los modelos.
ML_ZONA_HORARIA=America/La_Paz
